@*     ViewData["Title"] = "Add Movie"; *@
@* } *@
@model Movie

<h2>Add a Movie to the Database</h2>
<div class="form-input">
    <form method="post">
        <input type="hidden" asp-for="MovieId"/>
        
        <label asp-for="Title">Movie Title: </label>
        <br>
        <input asp-for="Title" required/>
        <br><br>
        <select asp-for="CategoryId">
            <option disabled selected>Select a Category</option>
            @foreach (var cat in ViewBag.Categories)
            {
                <option value="@cat.CategoryId">@cat.CategoryName</option>
            }

        </select>

        <br><br>
        <label asp-for="Year">Year Released: </label>
        <br>
        <input asp-for="Year" type="number"/>
        <br><br>
        <label asp-for="Director">Director: </label>
        <br>
        <input asp-for="Director"/>
        <br><br>
        <label asp-for="Rating"> Rating: </label>
        <br>
        <select asp-for="Rating">
            <option value="G">G</option>
            <option value="PG">PG</option>
            <option value="PG-13">PG-13</option>
            <option value="R">R</option>
        </select>
        <br>
        <label asp-for="Edited">Edited: </label>
        <label>
            Yes <input asp-for="Edited" class="radio-button" type="radio" name="edited" value="true"/>
        </label>
        <label>
            No <input asp-for="Edited" class="radio-button" type="radio" name="edited" value="false"/>
        </label>
        <br><br>
        <label asp-for="LentTo"> Lent To: </label>
        <br>
        <input asp-for="LentTo"/>
        <br><br>
        <br>
        <label asp-for="CopiedToPlex">Copied To Plex? </label>
        <label >
            Yes <input asp-for="CopiedToPlex" class="radio-button" type="radio" name="copiedtoplex" value="true"/>
        </label>
        <label>
            No <input asp-for="CopiedToPlex" class="radio-button" type="radio" name="copiedtoplex" value="false"/>
        </label>
        <br><br>
        <label asp-for="Notes">Notes: </label>
        <br>
        <input asp-for="Notes"/>
        <br><br>
        <button type="submit">Submit</button>
        <div asp-validation-summary="All"></div>
    </form>
    
</div>