@model List<Mission6.Models.Movie>

<table class="table table-bordered table-hover table-striped">
    <thead>
    <tr>
        <th>Movie ID</th>
        <th>Category</th>
        <th>Title</th>
        <th>Year</th>
        <th>Director</th>
        <th>Rating</th>
        <th>Edited</th>
        <th>LentTo</th>
        <th>Copied to Plex</th>
        <th>Notes</th>
        <th>Edit</th>
        <th>Delete</th>
    </tr>
    </thead>
    <tbody>
    
        @foreach (var mov in Model)
        {
            <tr>
                <td>@mov.MovieId</td>
                <td>@mov.Category?.CategoryName</td>
                <td>@mov.Title</td>
                <td>@mov.Year</td>
                <td>@mov.Director</td>
                <td>@mov.Rating</td>
                <td>@mov.Edited</td>
                <td>@mov.LentTo</td>
                <td>@mov.CopiedToPlex</td>
                <td>@mov.Notes</td>
                <td><a asp-controller="Home" asp-action="Edit" asp-route-MovieId="@mov.MovieId" class="btn btn-info">Edit</a></td>
                <td><a asp-controller="Home" asp-action="Delete" asp-route-MovieId="@mov.MovieId" class="btn btn-danger">Delete</a></td>
            </tr>
        }
    </tbody>
</table>